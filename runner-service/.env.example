RUNNER_PORT=8787
RUNNER_ALLOWED_ORIGIN=http://localhost:5173

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=

# Dedicated PostgreSQL 14 execution database for SQL runs.
# Must NOT be Supabase. Each fixture runs in its own schema inside a transaction.
# Docker Compose: postgresql://dsa_runner:CHANGE_ME@postgres:5432/dsa_sql_exec
# Local dev:      postgresql://localhost/dsa_sql_exec
SQL_EXEC_PG_DSN=

# Optional: path to local corpus JSON for dev before sql_problem_specs/fixtures tables are populated.
# Defaults to ../../sql-rebuild/out/corpus_expanded_candidates.json (relative to runner-service/).
# SQL_CORPUS_PATH=

RUNNER_MAX_TESTS=150
RUNNER_MAX_CODE_CHARS=200000
RUNNER_TIME_LIMIT=2
RUNNER_WALL_TIME_LIMIT=5
RUNNER_MEMORY_LIMIT_KB=262144
