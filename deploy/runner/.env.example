RUNNER_PORT=8787

# Allow requests from your frontend (Netlify / Vercel / local)
# Use comma-separated origins or * for open (not recommended for production)
RUNNER_ALLOWED_ORIGIN=https://YOUR_FRONTEND_DOMAIN.netlify.app

SUPABASE_URL=https://fjulxsdwycrmtamwfjxx.supabase.co
# Rotate this key immediately after first working deploy — see security note.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_ROTATED_KEY

# Judge0 on the same EC2 host, bound to 127.0.0.1:2358
# From inside the runner container, reach it via host.docker.internal
JUDGE0_URL=http://host.docker.internal:2358
# Set if you enabled AUTHN_TOKEN in judge0.conf, else leave blank
JUDGE0_API_KEY=

# Conservative limits — Python test suites are fast
RUNNER_MAX_TESTS=150
RUNNER_MAX_CODE_CHARS=200000
RUNNER_TIME_LIMIT=5
RUNNER_WALL_TIME_LIMIT=10
RUNNER_MEMORY_LIMIT_KB=262144

# Preferred durable auth for Vertex AI on the runner:
#   mkdir -p ./credentials
#   place a service-account key at ./credentials/practicer-runner.json
# If your org blocks service-account key creation, use GOOGLE_API_KEY instead.
GOOGLE_CLOUD_PROJECT=practicer-489910
GOOGLE_CLOUD_LOCATION=global
GOOGLE_API_KEY=
VERTEX_AI_MODEL_FLASH=gemini-3-flash-preview
VERTEX_AI_MODEL_PRO=gemini-3-pro-preview
VERTEX_AI_BACKGROUND_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/practicer-runner.json
